<Application x:Class="KKOsr2Sr6Link.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KKOsr2Sr6Link.Wpf"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Dark theme approximating the original Qt stylesheet -->
        <Color x:Key="BgColor">#2F363C</Color>
        <Color x:Key="PanelColor">#3A4152</Color>
        <Color x:Key="AccentColor">#FF79C6</Color>
        <SolidColorBrush x:Key="Bg" Color="#2F363C"/>
        <SolidColorBrush x:Key="Panel" Color="#3A4152"/>
        <SolidColorBrush x:Key="PanelDark" Color="#343B48"/>
        <SolidColorBrush x:Key="Accent" Color="#FF79C6"/>
        <SolidColorBrush x:Key="Fg" Color="#E1E1E1"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Background" Value="#3C434C"/>
            <Setter Property="BorderBrush" Value="#4A5160"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="CaretBrush" Value="{StaticResource Fg}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#202020"/>
            <Setter Property="Background" Value="#3C434C"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>
    </Application.Resources>
</Application>
