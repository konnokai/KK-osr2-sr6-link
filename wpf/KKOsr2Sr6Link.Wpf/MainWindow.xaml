<Window x:Class="KKOsr2Sr6Link.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:KKOsr2Sr6Link.Wpf.Controls"
        Title="Link osr2 sr6 to kk studio" Height="980" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        WindowStyle="None" ResizeMode="CanResize">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- title bar -->
        <Grid Grid.Row="0" Background="{StaticResource PanelDark}">
            <TextBlock x:Name="ClientLabel" Text="{DynamicResource L.ServerStopped}" VerticalAlignment="Center" Margin="14,0" FontSize="13"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinBtn" Content="—" Width="40" Margin="0" Click="Minimize_Click"/>
                <Button x:Name="MaxBtn" Content="◻" Width="40" Margin="0" Click="Maximize_Click"/>
                <Button x:Name="CloseBtn" Content="✕" Width="40" Margin="0" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <!-- body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- left nav -->
            <DockPanel Grid.Column="0" Background="{StaticResource PanelDark}">
                <Button DockPanel.Dock="Bottom" Content="{DynamicResource L.Settings}" Click="NavSettings_Click" Margin="6,2,6,8"/>
                <StackPanel>
                    <Button x:Name="RunServerBtn" Content="{DynamicResource L.RunServer}" Click="RunServer_Click" Height="44" Margin="6,8,6,8"/>
                    <Button Content="{DynamicResource L.Home}" Click="NavHome_Click" Margin="6,2"/>
                    <Button Content="{DynamicResource L.Scripter}" Click="NavScripter_Click" Margin="6,2"/>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Column="1" Margin="10">
                <!-- HOME -->
                <ScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="{DynamicResource L.LoadScene}" FontSize="16" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <!-- placeholders flanking the preview (no part-nav wired yet) -->
                                <Border Grid.Column="0" BorderBrush="#4A5160" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0"/>
                                <Grid Grid.Column="1">
                                    <Image x:Name="ScenePreview" Stretch="Uniform" MinHeight="240"/>
                                    <TextBlock x:Name="ScenePathLabel" Text="{DynamicResource L.NoSceneLoaded}" VerticalAlignment="Bottom"
                                               HorizontalAlignment="Center" Margin="6" TextWrapping="Wrap"/>
                                </Grid>
                                <Border Grid.Column="2" BorderBrush="#4A5160" BorderThickness="1" CornerRadius="4" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="{DynamicResource L.DevicesServerSetting}" FontSize="16" Margin="0,8,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <RadioButton Style="{StaticResource TabRadio}" Content="{DynamicResource L.SerialDevice}" Tag="serial" IsChecked="True" Checked="DeviceTab_Checked"/>
                            <RadioButton Style="{StaticResource TabRadio}" Content="{DynamicResource L.ButtplugDevice}" Tag="buttplug" Checked="DeviceTab_Checked"/>
                        </StackPanel>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <!-- serial -->
                                <Grid x:Name="SerialPanel">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource L.Com}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" x:Name="PortList"/>
                                        <Button Grid.Column="2" Content="⟳" Click="ReloadPorts_Click" Margin="6,0,0,0"/>
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource L.BaudRate}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="BaudBox" Text="115200"/>
                                        <Button Grid.Column="2" x:Name="LinkSerialBtn" Content="▷" Click="LinkSerial_Click" Margin="6,0,0,0"/>
                                    </Grid>
                                </Grid>
                                <!-- buttplug -->
                                <Grid x:Name="ButtplugPanel" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource L.DevicesList}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" x:Name="DeviceList" SelectionChanged="DeviceList_Changed"/>
                                        <Button Grid.Column="2" Content="⟳" Click="Rescan_Click" Margin="6,0,0,0"/>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource L.FeatureSelect}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" x:Name="FeatureList" SelectionChanged="FeatureList_Changed" Margin="0,0,16,0"/>
                                        <TextBlock Grid.Column="2" Text="{DynamicResource L.WorkOnAxes}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox Grid.Column="3" x:Name="AxisMapList" SelectionChanged="AxisMap_Changed">
                                            <ComboBoxItem>L0</ComboBoxItem><ComboBoxItem>L1</ComboBoxItem><ComboBoxItem>L2</ComboBoxItem>
                                            <ComboBoxItem>R0</ComboBoxItem><ComboBoxItem>R1</ComboBoxItem><ComboBoxItem>R2</ComboBoxItem>
                                        </ComboBox>
                                    </Grid>
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource L.IntifaceIp}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="WebIpBox" Text="ws://localhost:12345"/>
                                        <Button Grid.Column="2" x:Name="LinkIntifaceBtn" Content="▷" Click="LinkIntiface_Click" Margin="6,0,0,0"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource L.Server}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" x:Name="ServerIpBox" Text="127.0.0.1" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource L.Port}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="3" x:Name="ServerPortBox" Text="8000"/>
                        </Grid>

                        <Button Content="{DynamicResource L.ResetDevices}" Click="Reset_Click" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- SCRIPTER -->
                <ScrollViewer x:Name="PageScripter" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="{DynamicResource L.ScripterEdit}" HorizontalAlignment="Center" FontSize="15" Margin="0,2,0,8"/>

                        <!-- Overview / per-axis tabs -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <RadioButton Style="{StaticResource TabRadio}" Content="{DynamicResource L.Overview}" Tag="-1" IsChecked="True" Checked="ScripterTab_Checked"/>
                            <RadioButton Style="{StaticResource TabRadio}" Content="L0" Tag="0" Checked="ScripterTab_Checked"/>
                            <RadioButton Style="{StaticResource TabRadio}" Content="L1" Tag="1" Checked="ScripterTab_Checked"/>
                            <RadioButton Style="{StaticResource TabRadio}" Content="L2" Tag="2" Checked="ScripterTab_Checked"/>
                            <RadioButton Style="{StaticResource TabRadio}" Content="R0" Tag="3" Checked="ScripterTab_Checked"/>
                            <RadioButton Style="{StaticResource TabRadio}" Content="R1" Tag="4" Checked="ScripterTab_Checked"/>
                            <RadioButton Style="{StaticResource TabRadio}" Content="R2" Tag="5" Checked="ScripterTab_Checked"/>
                        </StackPanel>

                        <!-- selected editing surface (overview or one axis) -->
                        <Border Style="{StaticResource Card}" Padding="6">
                            <ScrollViewer x:Name="SurfaceHost" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"/>
                        </Border>

                        <!-- characters -->
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource L.GirlsList}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Grid.Column="1" x:Name="GirlList" Margin="0,0,16,0"/>
                                <TextBlock Grid.Column="2" Text="{DynamicResource L.BoysList}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Grid.Column="3" x:Name="BoyList"/>
                            </Grid>
                        </Border>

                        <!-- part / mode / generate -->
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource L.SelectPart}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Grid.Column="1" x:Name="PartList" Margin="0,0,16,0"/>
                                <TextBlock Grid.Column="2" Text="{DynamicResource L.LovemakingMode}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Grid.Column="3" x:Name="ModeList" Margin="0,0,16,0">
                                    <ComboBoxItem IsSelected="True">normal</ComboBoxItem>
                                    <ComboBoxItem>blowjob</ComboBoxItem>
                                    <ComboBoxItem>breastsex</ComboBoxItem>
                                    <ComboBoxItem>handjobL</ComboBoxItem>
                                    <ComboBoxItem>handjobR</ComboBoxItem>
                                </ComboBox>
                                 <Button Grid.Column="4" x:Name="CreatePartBtn" Content="{DynamicResource L.Create}" Click="CreatePart_Click" Margin="0,0,6,0"/>
                                 <Button Grid.Column="5" x:Name="GenerateBtn" Content="{DynamicResource L.Generates}" Click="Generate_Click"/>
                            </Grid>
                        </Border>

                        <!-- chara visibility / select-on-switch -->
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="{DynamicResource L.ShowCharas}" Click="ShowChars_Click" Margin="0,0,6,0"/>
                                <Button Grid.Column="1" Content="{DynamicResource L.HideCharas}" Click="HideChars_Click" Margin="0,0,6,0"/>
                                <CheckBox Grid.Column="2" x:Name="SelectOnSwitchCheck" Content="{DynamicResource L.SelectOnSwitch}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="{DynamicResource L.OutputRange}" HorizontalAlignment="Center" FontSize="15" Margin="0,4,0,8"/>

                        <!-- per-axis output range, L* left / R* right -->
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" x:Name="SliderColLeft" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" x:Name="SliderColRight"/>
                            </Grid>
                        </Border>

                        <!-- per-axis enable -->
                        <Border Style="{StaticResource Card}">
                            <UniformGrid Columns="6">
                                <CheckBox x:Name="EnL0" Content="L0" IsChecked="True"/>
                                <CheckBox x:Name="EnL1" Content="L1" IsChecked="True"/>
                                <CheckBox x:Name="EnL2" Content="L2" IsChecked="True"/>
                                <CheckBox x:Name="EnR0" Content="R0" IsChecked="True"/>
                                <CheckBox x:Name="EnR1" Content="R1" IsChecked="True"/>
                                <CheckBox x:Name="EnR2" Content="R2" IsChecked="True"/>
                            </UniformGrid>
                        </Border>

                        <Button Click="Convert_Click" HorizontalContentAlignment="Stretch" Margin="0,0,0,4">
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="{DynamicResource L.ConvertFunscript}"/>
                                <TextBlock DockPanel.Dock="Right" Text="⟳"/>
                            </DockPanel>
                        </Button>
                        <Button Click="Save_Click" HorizontalContentAlignment="Stretch" Margin="0,0,0,4">
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="{DynamicResource L.SaveScripter}"/>
                                <TextBlock DockPanel.Dock="Right" Text="💾"/>
                            </DockPanel>
                        </Button>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="ProfileSourceLabel" Grid.Row="0" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                <Grid Grid.Row="1" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource L.ProfileSelector}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" x:Name="ProfilePickerButton" Click="ProfilePicker_Click" Margin="0,0,6,0"
                                            Padding="5" HorizontalContentAlignment="Stretch">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="120" Height="68" BorderBrush="#4A5160" BorderThickness="1" CornerRadius="3">
                                                <Grid>
                                                    <TextBlock Text="{DynamicResource L.NoProfilePreview}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="#8C96A5" FontSize="11"/>
                                                    <Image x:Name="ProfilePreview" Stretch="UniformToFill"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="ProfileSelectionLabel" TextWrapping="Wrap" FontSize="14"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button Grid.Column="2" x:Name="LoadSharedProfileBtn" Content="{DynamicResource L.LoadSharedProfile}" Click="LoadSharedProfile_Click"/>
                                </Grid>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="ProfileKeyBox" Margin="0,0,6,0"/>
                                    <Button Grid.Column="1" Content="{DynamicResource L.CreateSharedProfile}" Click="CreateSharedProfile_Click" Margin="0,0,6,0"/>
                                    <Button Grid.Column="2" Content="{DynamicResource L.ForkProfile}" Click="ForkProfile_Click"/>
                                </Grid>
                                <Grid Grid.Row="3" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="SaveSharedProfileBtn" Click="SaveSharedProfile_Click" Margin="0,0,6,0"/>
                                    <Button Grid.Column="1" Content="{DynamicResource L.UnbindProfile}" Click="UnbindProfile_Click"/>
                                </Grid>
                                <TextBlock x:Name="ProfileStatusLabel" Grid.Row="4" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                        <Button Click="OpenFolder_Click" HorizontalContentAlignment="Stretch" Margin="0,0,0,4">
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="{DynamicResource L.OpenFolders}"/>
                                <TextBlock DockPanel.Dock="Right" Text="📁"/>
                            </DockPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- SETTINGS -->
                <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="{DynamicResource L.GameSetting}" FontSize="16" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource L.GameRoot}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" x:Name="GameRootBox"/>
                                <Button Grid.Column="2" Content="📁" Click="BrowseGameRoot_Click" Margin="6,0,0,0"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="{DynamicResource L.ScripterEditSetting}" FontSize="16" Margin="0,8,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource L.RebuildAllDesc}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" x:Name="RebuildAllCheck" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="{DynamicResource L.Language}" FontSize="16" Margin="0,8,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource L.Language}" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" x:Name="LanguageList" SelectionChanged="Language_Changed">
                                    <ComboBoxItem Tag="en">English</ComboBoxItem>
                                    <ComboBoxItem Tag="zh-Hant">繁體中文</ComboBoxItem>
                                </ComboBox>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- status bar -->
        <TextBlock x:Name="StatusBar" Grid.Row="2" Background="{StaticResource PanelDark}"
                   VerticalAlignment="Stretch" Padding="10,4" Text="ready"/>
    </Grid>
</Window>
