<Window x:Class="KKOsr2Sr6Link.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:KKOsr2Sr6Link.Wpf.Controls"
        Title="Link osr2 sr6 to kk studio" Height="720" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        WindowStyle="None" ResizeMode="CanResize">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- title bar -->
        <Grid Grid.Row="0" Background="{StaticResource PanelDark}">
            <TextBlock Text="Link osr2 sr6 → kk studio" VerticalAlignment="Center" Margin="14,0" FontSize="13"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinBtn" Content="—" Width="40" Margin="0" Click="Minimize_Click"/>
                <Button x:Name="MaxBtn" Content="◻" Width="40" Margin="0" Click="Maximize_Click"/>
                <Button x:Name="CloseBtn" Content="✕" Width="40" Margin="0" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <!-- body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- left nav -->
            <StackPanel Grid.Column="0" Background="{StaticResource PanelDark}">
                <Button Content="Home" Click="NavHome_Click" Margin="6,8,6,2"/>
                <Button Content="Scripter" Click="NavScripter_Click" Margin="6,2"/>
                <Button Content="Settings" Click="NavSettings_Click" Margin="6,2"/>
            </StackPanel>

            <Grid Grid.Column="1" Margin="10">
                <!-- HOME -->
                <Grid x:Name="PageHome">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <Button x:Name="RunServerBtn" Content="Run server" Click="RunServer_Click" Height="44"/>
                        <TextBlock x:Name="ClientLabel" Text="server stopped" Margin="2,8"/>
                        <Separator Margin="0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Girl"/>
                                <ComboBox x:Name="GirlList"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Boy"/>
                                <ComboBox x:Name="BoyList"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <Button Content="Show chars" Click="ShowChars_Click"/>
                            <Button Content="Hide chars" Click="HideChars_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <Button Content="Save script" Click="Save_Click"/>
                            <Button Content="Export funscript" Click="Convert_Click"/>
                            <Button Content="Open folder" Click="OpenFolder_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource PanelDark}" CornerRadius="6">
                        <Grid>
                            <Image x:Name="ScenePreview" Stretch="Uniform" Margin="8"/>
                            <TextBlock x:Name="ScenePathLabel" Text="no scene loaded" VerticalAlignment="Bottom"
                                       HorizontalAlignment="Center" Margin="6" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- SCRIPTER -->
                <Grid x:Name="PageScripter" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="Mode" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="ModeList" Width="110" Margin="0,0,12,0">
                            <ComboBoxItem IsSelected="True">normal</ComboBoxItem>
                            <ComboBoxItem>blowjob</ComboBoxItem>
                            <ComboBoxItem>breastsex</ComboBoxItem>
                            <ComboBoxItem>handjobL</ComboBoxItem>
                            <ComboBoxItem>handjobR</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Text="Part" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="PartList" Width="90" Margin="0,0,12,0"/>
                        <CheckBox x:Name="RebuildAllCheck" Content="rebuild all axes" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <CheckBox x:Name="EnL0" Content="L0" IsChecked="True" Margin="3,0"/>
                        <CheckBox x:Name="EnL1" Content="L1" IsChecked="True" Margin="3,0"/>
                        <CheckBox x:Name="EnL2" Content="L2" IsChecked="True" Margin="3,0"/>
                        <CheckBox x:Name="EnR0" Content="R0" IsChecked="True" Margin="3,0"/>
                        <CheckBox x:Name="EnR1" Content="R1" IsChecked="True" Margin="3,0"/>
                        <CheckBox x:Name="EnR2" Content="R2" IsChecked="True" Margin="3,0"/>
                    </WrapPanel>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ScripterStack"/>
                    </ScrollViewer>
                </Grid>

                <!-- SETTINGS -->
                <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Serial (OSR2 / SR6)" FontSize="14" Margin="0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <ComboBox x:Name="PortList" Width="240"/>
                            <Button Content="Reload" Click="ReloadPorts_Click"/>
                            <TextBlock Text="Baud" VerticalAlignment="Center" Margin="10,0,4,0"/>
                            <TextBox x:Name="BaudBox" Width="90" Text="115200"/>
                            <Button x:Name="LinkSerialBtn" Content="Link serial" Click="LinkSerial_Click"/>
                        </StackPanel>

                        <TextBlock Text="Plugin link server" FontSize="14" Margin="0,12,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="IP" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="ServerIpBox" Width="140" Text="127.0.0.1"/>
                            <TextBlock Text="Port" VerticalAlignment="Center" Margin="10,0,4,0"/>
                            <TextBox x:Name="ServerPortBox" Width="80" Text="8000"/>
                        </StackPanel>

                        <TextBlock Text="Intiface Central" FontSize="14" Margin="0,12,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBox x:Name="WebIpBox" Width="240" Text="ws://localhost:12345"/>
                            <Button x:Name="LinkIntifaceBtn" Content="Connect" Click="LinkIntiface_Click"/>
                            <Button Content="Rescan" Click="Rescan_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Device" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox x:Name="DeviceList" Width="240" SelectionChanged="DeviceList_Changed"/>
                            <TextBlock Text="Feature→axis" VerticalAlignment="Center" Margin="10,0,4,0"/>
                            <ComboBox x:Name="FeatureList" Width="120"/>
                        </StackPanel>

                        <TextBlock Text="Game root (for resolving scene paths)" FontSize="14" Margin="0,12,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBox x:Name="GameRootBox" Width="360"/>
                            <Button Content="Browse" Click="BrowseGameRoot_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- status bar -->
        <TextBlock x:Name="StatusBar" Grid.Row="2" Background="{StaticResource PanelDark}"
                   VerticalAlignment="Stretch" Padding="10,4" Text="ready"/>
    </Grid>
</Window>
